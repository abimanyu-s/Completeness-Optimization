{
	"name": "df_filter_customers",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_input_customers_csv",
						"type": "DatasetReference"
					},
					"name": "dsinptcust"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_output_customers_csv",
						"type": "DatasetReference"
					},
					"name": "dsoutuputCust"
				}
			],
			"transformations": [
				{
					"name": "filterbyCountry",
					"description": "filtering only customers in US"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Index as string,",
				"          {Customer Id} as string,",
				"          {First Name} as string,",
				"          {Last Name} as string,",
				"          Company as string,",
				"          City as string,",
				"          Country as string,",
				"          {Phone 1} as string,",
				"          {Phone 2} as string,",
				"          Email as string,",
				"          {Subscription Date} as string,",
				"          Website as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dsinptcust",
				"dsinptcust filter(Country == 'United States of America') ~> filterbyCountry",
				"filterbyCountry sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[''],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> dsoutuputCust"
			]
		}
	}
}